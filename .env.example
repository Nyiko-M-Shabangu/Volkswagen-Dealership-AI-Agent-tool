# ==============================================================================
# VW Dealership Comparison: Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Places API (New)
# Get key: https://console.cloud.google.com/apis/credentials
# Docs: https://developers.google.com/maps/documentation/places/web-service/op-overview
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_places_api_key_here

# ------------------------------------------------------------------------------
# LLM Provider Selection
# Options: 'openai' | 'cloudflare'
# ------------------------------------------------------------------------------
AI_PROVIDER=openai

# ------------------------------------------------------------------------------
# Provider Option 1: OpenAI
# Get key: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Provider Option 2: Cloudflare Workers AI
# Dashboard: https://dash.cloudflare.com/
# Get Token: My Profile -> API Tokens -> Create Custom Token with "Workers AI Read"
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-70b-instruct

# ------------------------------------------------------------------------------
# Benchmark Settings
# Default location: Johannesburg / Sandton, South Africa
# ------------------------------------------------------------------------------
BENCHMARK_ITERATIONS=50
BENCHMARK_LOCATION_LAT=-26.1044
BENCHMARK_LOCATION_LNG=28.0645
